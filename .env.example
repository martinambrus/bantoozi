# Bantoozi environment variables (spec 01 §3). Placeholder values only — never commit real secrets.
# The values match the local development stack (infra/compose.dev.yml defaults); production uses
# real secrets from protected host files (spec 11 §2). "Used by" lists the processes that read
# each variable; `loadConfig({process})` validates them.

# development / test / production (all)
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# api, test: connection as role bantoozi_app (RLS enforced)
DATABASE_URL=postgres://bantoozi_app:bantoozi_app@localhost:5432/bantoozi
# worker, eval: connection as role bantoozi_worker (BYPASSRLS)
DATABASE_URL_WORKER=postgres://bantoozi_worker:bantoozi_worker@localhost:5432/bantoozi
# migrate: connection as role bantoozi_owner
DATABASE_URL_MIGRATE=postgres://bantoozi_owner:bantoozi_owner@localhost:5432/bantoozi
# test, eval: superuser used only to create template/test/E2E/dry-run databases
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# compose.test.yml, test: host port of the test Postgres
PG_TEST_PORT=5433
# compose.dev.yml: host port of the dev Postgres
PG_DEV_PORT=5432
# compose.dev.yml: host port of the dev LibreTranslate (--profile translate)
LT_DEV_PORT=5000
# compose / init.sh only (database bootstrap; never read by the apps)
POSTGRES_PASSWORD=postgres
BANTOOZI_OWNER_PASSWORD=bantoozi_owner
BANTOOZI_APP_PASSWORD=bantoozi_app
BANTOOZI_WORKER_PASSWORD=bantoozi_worker

# ── HTTP API and sessions ────────────────────────────────────────────────────────────────────
# api, worker, eval: links, CSRF Origin check and the fetcher User-Agent
PUBLIC_BASE_URL=http://localhost:5173
# api
API_PORT=3000
# api: bind address (default 0.0.0.0 in production, 127.0.0.1 otherwise)
API_HOST=
# api
SESSION_COOKIE_NAME=bantoozi_sid
# api: sliding session expiry
SESSION_TTL_DAYS=60
# api (required): secret mixed into login-code hashes (≥ 32 characters in production)
SESSION_PEPPER=change-me-to-a-long-random-string
# api: invite / open / closed (settings['signup_mode'] overrides it)
SIGNUP_MODE=invite
# api: runtime default (Admin → Settings api.rate_limits_enabled overrides it). false only with NODE_ENV=test;
# refused here in production (the setting can turn off only the general limits there)
RATE_LIMITS_ENABLED=true
# api, worker: OPTIONAL, bootstrap only: a listed address needs no invite and becomes admin when its account is
# created or while no active admin exists. The first admin is normally created at /setup with the setup token the
# API logs at start-up. Afterwards the stored role rules (a demotion sticks); alerts go to the active admins and
# use this list only as a fallback
ADMIN_EMAILS=admin@example.com
# api, worker: comma list of hosts the provider base URLs (TypeSafe, Ollama, LibreTranslate) may use in
# production when set in Admin → Settings, e.g. api.typesafe.ai,ollama.com (host or host:port, any port when
# omitted). Empty: no stored base URL is accepted in production. The URLs in this file are not checked
PROVIDER_HOST_ALLOWLIST=

# ── Email ────────────────────────────────────────────────────────────────────────────────────
# api, worker: smtp (default in production) or log (default in development/test; refused in production)
MAIL_TRANSPORT=log
# api, worker: required in production
SMTP_URL=smtp://user:change-me@smtp.example.com:587
# api, worker
MAIL_FROM=Bantoozi <no-reply@localhost>

# ── Decision engine and providers ────────────────────────────────────────────────────────────
# worker, eval: optional bootstrap Jev key, used only if no DB credential row exists
TYPESAFE_API_KEY=
# api, worker, eval: always a pinned version in production. Runtime default: engine.typesafe_model in
# Admin → Settings overrides it (workers restart themselves; confirm an eval replay first)
TYPESAFE_MODEL=jev-1.13.0
# api, worker, eval: runtime default (engine.typesafe_base_url)
TYPESAFE_BASE_URL=https://api.typesafe.ai
# worker, eval: cost accounting. Runtime default (engine.typesafe_price_per_mtok_usd)
TYPESAFE_PRICE_PER_MTOK_USD=0.042
# worker, eval: max in-flight Jev calls per process. Runtime default (engine.concurrency)
ENGINE_CONCURRENCY=8
# worker: daily spend guard
DAILY_BUDGET_USD=2.00
# worker, eval: optional bootstrap Ollama key, used only if no DB credential row exists
OLLAMA_API_KEY=
# api, worker, eval: id of the active wrapping key in the host-only keyring
PROVIDER_MASTER_KEY_ID=
# api, worker, eval: JSON map of key id to base64 32-byte AES key (protected host secret)
PROVIDER_MASTER_KEYS=
# worker, eval: runtime default (engine.ollama_base_url)
OLLAMA_BASE_URL=https://ollama.com
# worker, eval: runtime default (engine.ollama_models, fast and strong together)
OLLAMA_MODEL_FAST=glm-5.3-flash
# worker, eval
OLLAMA_MODEL_STRONG=glm-5.3
# worker, eval: match the Ollama plan (Free 1, Pro 3, Max 10). Runtime default (engine.ollama_max_concurrency)
OLLAMA_MAX_CONCURRENCY=1
# worker: enable the LLM fallback engine. Runtime default (engine.llm_fallback_enabled)
LLM_FALLBACK_ENABLED=false

# ── Translation and ingestion ────────────────────────────────────────────────────────────────
# api, worker, eval: tier-1 machine translation; runtime default (translate.libretranslate_url); default http://libretranslate:5000 (production compose)
LIBRETRANSLATE_URL=http://localhost:5000
# worker: initial per-language classification mode (stored by the seed; later changes have no effect)
LANGUAGE_MODES={"en":"native","sk":"native","cs":"native"}
# api, worker, eval: default BantooziBot/1.0 (+${PUBLIC_BASE_URL}/bot)
FETCH_USER_AGENT=BantooziBot/1.0 (+http://localhost:5173/bot)
# api, worker, eval: 5 MB for feeds and pages. Runtime default (fetch.limits.maxBytes)
FETCH_MAX_BYTES=5242880
# api, worker, eval: runtime default (fetch.limits.timeoutMs)
FETCH_TIMEOUT_MS=20000
# api, worker, eval: tests only; refused when NODE_ENV=production
FETCH_ALLOW_PRIVATE=false
# worker: automatic age window. Runtime default (ingest.max_age_days)
INGEST_MAX_AGE_DAYS=14
# worker: spec 05 §5.5. Runtime default (engine.prefilter_min_cards); the built-in value is 60
PREFILTER_MIN_CARDS=60

# ── Worker, evaluation and observability ─────────────────────────────────────────────────────
# worker: M3a stops the pipeline after extract
EVAL_INGEST_ONLY=false
# eval: base URL printed in rater links
EVAL_PUBLIC_URL=http://localhost:5180
# eval: engine-call cache shared by all worktrees
EVAL_CACHE_DIR=~/.cache/bantoozi-eval
# worker: comma list of queues; * = every queue except the dedicated Laya queues
WORKER_QUEUES=*
# all
LOG_LEVEL=info
# api, worker, scripts: bearer token for /metrics and POST /admin/ops-event
METRICS_TOKEN=change-me
# worker
WORKER_METRICS_PORT=9101
# worker: health/metrics bind address (default 0.0.0.0 in production, 127.0.0.1 otherwise)
WORKER_METRICS_HOST=
# worker: drain and exit (the supervisor restarts it) when a restart-class runtime setting changed in Admin →
# Settings (Jev model, base URLs, LLM fallback, Ollama models or concurrency, LibreTranslate URL). Default true in
# production, false elsewhere (then it only warns and reports pendingRestart)
WORKER_SELF_RESTART=
# all: tracing is enabled only when set
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Deletion ledger (spec 11 §5.1) ───────────────────────────────────────────────────────────
# worker: file the deletion ledger is appended to (uploaded by backup.sh); with the two below it gates house.purge-users
DELETION_LEDGER_PATH=
# worker: age public key (age1...) the ledger entries are encrypted to; the private key stays off the box
DELETION_LEDGER_RECIPIENT=
# worker: HMAC key (at least 32 chars) for the email hash of a ledger entry
DELETION_HMAC_KEY=
