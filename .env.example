# Bantoozi environment variables (spec 01 §3). Placeholder values only — never commit real secrets.
# "Used by" lists the processes that read each variable; `loadConfig({process})` validates them.

# development / test / production (all)
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# api, test: connection as role bantoozi_app (RLS enforced)
DATABASE_URL=postgres://bantoozi_app:change-me@localhost:5432/bantoozi
# worker, eval: connection as role bantoozi_worker (BYPASSRLS)
DATABASE_URL_WORKER=postgres://bantoozi_worker:change-me@localhost:5432/bantoozi
# migrate: connection as role bantoozi_owner
DATABASE_URL_MIGRATE=postgres://bantoozi_owner:change-me@localhost:5432/bantoozi
# test, eval: superuser used only to create template/test/E2E/dry-run databases
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# compose.test.yml, test: host port of the test Postgres
PG_TEST_PORT=5433
# compose.dev.yml: host port of the dev Postgres
PG_DEV_PORT=5432
# compose / init.sh only (database bootstrap; never read by the apps)
POSTGRES_PASSWORD=change-me
BANTOOZI_OWNER_PASSWORD=change-me
BANTOOZI_APP_PASSWORD=change-me
BANTOOZI_WORKER_PASSWORD=change-me

# ── HTTP API and sessions ────────────────────────────────────────────────────────────────────
# api, worker, eval: links, CSRF Origin check and the fetcher User-Agent
PUBLIC_BASE_URL=http://localhost:5173
# api
API_PORT=3000
# api
SESSION_COOKIE_NAME=bantoozi_sid
# api: sliding session expiry
SESSION_TTL_DAYS=60
# api (required): secret mixed into login-code hashes (≥ 32 characters in production)
SESSION_PEPPER=change-me-to-a-long-random-string
# api: invite / open / closed (settings['signup_mode'] overrides it)
SIGNUP_MODE=invite
# api: false only for E2E/load tests with NODE_ENV=test; refused in production
RATE_LIMITS_ENABLED=true
# api, worker: comma list of admin emails (no invite needed; alert recipients)
ADMIN_EMAILS=admin@example.com

# ── Email ────────────────────────────────────────────────────────────────────────────────────
# api, worker: smtp (default in production) or log (default in development/test; refused in production)
MAIL_TRANSPORT=log
# api, worker: required in production
SMTP_URL=smtp://user:change-me@smtp.example.com:587
# api, worker
MAIL_FROM=Bantoozi <no-reply@localhost>

# ── Decision engine and providers ────────────────────────────────────────────────────────────
# worker, eval: optional bootstrap Jev key, used only if no DB credential row exists
TYPESAFE_API_KEY=
# worker, eval: always a pinned version in production
TYPESAFE_MODEL=jev-1.13.0
# worker, eval
TYPESAFE_BASE_URL=https://api.typesafe.ai
# worker, eval: cost accounting
TYPESAFE_PRICE_PER_MTOK_USD=0.042
# worker, eval: max in-flight Jev calls per process
ENGINE_CONCURRENCY=8
# worker: daily spend guard
DAILY_BUDGET_USD=2.00
# worker, eval: optional bootstrap Ollama key, used only if no DB credential row exists
OLLAMA_API_KEY=
# api, worker, eval: id of the active wrapping key in the host-only keyring
PROVIDER_MASTER_KEY_ID=
# api, worker, eval: JSON map of key id to base64 32-byte AES key (protected host secret)
PROVIDER_MASTER_KEYS=
# worker, eval
OLLAMA_BASE_URL=https://ollama.com
# worker, eval
OLLAMA_MODEL_FAST=glm-5.3-flash
# worker, eval
OLLAMA_MODEL_STRONG=glm-5.3
# worker, eval: match the Ollama plan (Free 1, Pro 3, Max 10)
OLLAMA_MAX_CONCURRENCY=1
# worker: enable the LLM fallback engine
LLM_FALLBACK_ENABLED=false

# ── Translation and ingestion ────────────────────────────────────────────────────────────────
# api, worker, eval: tier-1 machine translation (dev apps on the host: http://localhost:5000)
LIBRETRANSLATE_URL=http://libretranslate:5000
# worker: initial per-language classification mode (stored by the seed; later changes have no effect)
LANGUAGE_MODES={"en":"native","sk":"native","cs":"native"}
# api, worker, eval: default BantooziBot/1.0 (+${PUBLIC_BASE_URL}/bot)
FETCH_USER_AGENT=BantooziBot/1.0 (+http://localhost:5173/bot)
# api, worker, eval: 5 MB for feeds and pages
FETCH_MAX_BYTES=5242880
# api, worker, eval
FETCH_TIMEOUT_MS=20000
# api, worker, eval: tests only; refused when NODE_ENV=production
FETCH_ALLOW_PRIVATE=false
# worker: automatic age window
INGEST_MAX_AGE_DAYS=14
# worker: spec 05 §5.5
PREFILTER_MIN_CARDS=60

# ── Worker, evaluation and observability ─────────────────────────────────────────────────────
# worker: M3a stops the pipeline after extract
EVAL_INGEST_ONLY=false
# eval: base URL printed in rater links
EVAL_PUBLIC_URL=http://localhost:5180
# eval: engine-call cache shared by all worktrees
EVAL_CACHE_DIR=~/.cache/bantoozi-eval
# worker: comma list of queues; * = every queue except the dedicated Laya queues
WORKER_QUEUES=*
# all
LOG_LEVEL=info
# api, worker, scripts: bearer token for /metrics and POST /admin/ops-event
METRICS_TOKEN=change-me
# worker
WORKER_METRICS_PORT=9101
# all: tracing is enabled only when set
OTEL_EXPORTER_OTLP_ENDPOINT=
