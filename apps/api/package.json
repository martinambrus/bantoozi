{
  "name": "@bantoozi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP API (spec 08)",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "dev": "tsx --conditions=bantoozi-source watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bantoozi/db": "workspace:*",
    "@bantoozi/shared": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bantoozi/testing": "workspace:*",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15"
  }
}
