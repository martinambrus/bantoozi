{
  "name": "@bantoozi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "pg-boss consumers, outbox relay and cron (specs 03–07, 11)",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "dev": "tsx watch --conditions=bantoozi-source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "seed": "tsx --conditions=bantoozi-source --env-file-if-exists=../../.env src/seed.ts",
    "cli": "tsx --conditions=bantoozi-source --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@bantoozi/db": "workspace:*",
    "@bantoozi/engine": "workspace:*",
    "@bantoozi/feeds": "workspace:*",
    "@bantoozi/questions": "workspace:*",
    "@bantoozi/ranker": "workspace:*",
    "@bantoozi/shared": "workspace:*",
    "@bantoozi/translate": "workspace:*",
    "commander": "15.0.0",
    "pg": "8.23.0",
    "pg-boss": "10.4.2",
    "pino": "10.3.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@bantoozi/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15"
  }
}
