# Caddy 2 for the production stack (spec 01 §4; spec 11 §2, §3, §7). The image is built from
# infra/docker/Dockerfile (target `caddy`) on the pinned caddy:2 index digest, with the web build
# (apps/web/dist) baked in at /srv/web (spec 11 §3).
#
# Environment: PUBLIC_HOST is the site address (a domain name gets Let's Encrypt certificates; the
# default localhost uses Caddy's internal CA); ACME_EMAIL is the ACME account contact.
{
	email {$ACME_EMAIL}
}

# Security headers (spec 11 §7). `defer` applies them as the response is written, replacing any
# value the API sets itself.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		defer
	}
}

{$PUBLIC_HOST:localhost} {
	root * /srv/web
	import security_headers

	# Access log on stdout (the json-file driver rotates it). Raw URL queries, cookies and the
	# Authorization header never reach it (spec 11 §7).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	# Metrics are internal (spec 11 §3): scraped inside the compose network, never from outside.
	@metrics path /metrics /metrics/* /api/v1/metrics /api/v1/metrics/*
	handle @metrics {
		respond "404 Not Found" 404
	}

	# The API keeps its /api/v1 prefix: `handle`, never `handle_path` (which would strip it).
	# Unknown API paths get the API's own 404, never the SPA's index.html.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# Content-hashed build output, cached for a year. A missing file is a 404, never index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Everything else: index.html, the service worker /sw.js and other unhashed files, revalidated on
	# every use. The static pages /privacy and /bot are directories with their own index.html; any
	# other path is a client-side route and gets the SPA's index.html.
	handle {
		header Cache-Control "no-cache"
		encode zstd gzip
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# Errors Caddy itself produces (a missing asset, the API unreachable): plain text that is never
	# cached (it replaces the immutable header of /assets/*) and carries the same security headers.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
