# Local production-like rehearsal of infra/scripts/deploy.sh (no production host needed):
#   infra/scripts/deploy.sh --local-rehearsal --env-file <copy of this file> HEAD
# NODE_ENV=production inside the containers, https through Caddy's internal CA on localhost, the
# `mailpit` mail catcher (compose profile `rehearsal`, no ports published) and no internet egress.
# Every value below is a PUBLIC throwaway for a local stack: never reuse any of them anywhere else.
# COMPOSE_PROJECT_NAME keeps the rehearsal apart from the bantoozi-prod project.
COMPOSE_PROJECT_NAME=bantoozi-prod-rehearsal

PUBLIC_HOST=localhost
ACME_EMAIL=rehearsal@example.com
# Non-default host ports so the rehearsal never collides with the dev and test stacks.
HTTP_PORT=18081
HTTPS_PORT=18444
COMPOSE_PROFILES=
PUBLIC_BASE_URL=https://localhost:18444

POSTGRES_PASSWORD=rehearsal0postgres0pw00000000000
BANTOOZI_OWNER_PASSWORD=rehearsal0owner0pw0000000000000
BANTOOZI_APP_PASSWORD=rehearsal0app0pw00000000000000
BANTOOZI_WORKER_PASSWORD=rehearsal0worker0pw0000000000000

SESSION_PEPPER=rehearsal-session-pepper-0123456789abcdef
SIGNUP_MODE=invite
ADMIN_EMAILS=admin@example.com
METRICS_TOKEN=rehearsal-metrics-token-0123456789abcdef

# NODE_ENV=production refuses the log transport: a local mail catcher takes its place.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM='Bantoozi <no-reply@localhost>'

TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
OLLAMA_API_KEY=
PROVIDER_MASTER_KEY_ID=
PROVIDER_MASTER_KEYS=
DAILY_BUDGET_USD=0
LLM_FALLBACK_ENABLED=false

LIBRETRANSLATE_URL=http://libretranslate:5000
LANGUAGE_MODES='{"en":"native","sk":"native","cs":"native"}'
FETCH_ALLOW_PRIVATE=false

LOG_LEVEL=info

DELETION_LEDGER_PATH=
DELETION_LEDGER_RECIPIENT=
DELETION_HMAC_KEY=
