# Production environment for infra/compose.yml and infra/scripts/deploy.sh (spec 11 §2, spec 01 §3).
# Copy to a protected host file (mode 600, outside the repository), replace EVERY placeholder and
# pass it with `deploy.sh --env-file <file> <release-tag>`. Values here are placeholders only.
# Values are read by docker compose: avoid `$` and quote characters in secrets; a database password
# ends up inside a URL, so use letters and digits only.

# ── Public site ──────────────────────────────────────────────────────────────────────────────
# Site address Caddy serves; a domain name gets Let's Encrypt certificates.
PUBLIC_HOST=bantoozi.example.com
# Contact address registered with the ACME account.
ACME_EMAIL=admin@example.com
# Host ports of Caddy (80 and 443 on the production host).
HTTP_PORT=80
HTTPS_PORT=443
# Optional compose profiles, comma separated: translate (LibreTranslate), laya (worker-laya).
COMPOSE_PROFILES=
# api, worker: links, CSRF Origin check and the fetcher User-Agent; https in production.
PUBLIC_BASE_URL=https://bantoozi.example.com

# ── Database bootstrap and roles ─────────────────────────────────────────────────────────────
# Distinct passwords; the roles are created by infra/postgres/init.sh on the first start only.
POSTGRES_PASSWORD=changeme0postgres0pw00000000000000
BANTOOZI_OWNER_PASSWORD=changeme0owner0pw0000000000000000
BANTOOZI_APP_PASSWORD=changeme0app0pw0000000000000000000
BANTOOZI_WORKER_PASSWORD=changeme0worker0pw00000000000000

# ── API and sessions ─────────────────────────────────────────────────────────────────────────
# At least 32 characters.
SESSION_PEPPER=change-me-session-pepper-at-least-32-chars
SIGNUP_MODE=invite
# Comma list of admin emails (no invite needed; alert recipients).
ADMIN_EMAILS=admin@example.com
# At least 32 characters; bearer token for /metrics and POST /admin/ops-event.
METRICS_TOKEN=change-me-metrics-token-at-least-32-chars

# ── Email (required in production) ───────────────────────────────────────────────────────────
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:change-me@smtp.example.com:587
MAIL_FROM='Bantoozi <no-reply@example.com>'

# ── Decision engine and providers ────────────────────────────────────────────────────────────
# A pinned version in production.
TYPESAFE_MODEL=jev-1.13.0
# Optional bootstrap keys, used only if no database credential row exists.
TYPESAFE_API_KEY=
OLLAMA_API_KEY=
# Host-only keyring: the id of the active key and a JSON map of key id to base64 32-byte AES key.
PROVIDER_MASTER_KEY_ID=
PROVIDER_MASTER_KEYS=
DAILY_BUDGET_USD=2.00
LLM_FALLBACK_ENABLED=false

# ── Translation and ingestion ────────────────────────────────────────────────────────────────
# The translate profile serves this address inside the stack.
LIBRETRANSLATE_URL=http://libretranslate:5000
# Initial per-language mode, stored by the seed (later changes have no effect).
LANGUAGE_MODES='{"en":"native","sk":"native","cs":"native"}'
FETCH_ALLOW_PRIVATE=false

# ── Logging ──────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Deletion ledger (spec 11 §5.1) ───────────────────────────────────────────────────────────
DELETION_LEDGER_PATH=
DELETION_LEDGER_RECIPIENT=
DELETION_HMAC_KEY=
