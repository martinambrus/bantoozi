{
  "name": "@bantoozi/questions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Question sets, builders, taxonomy, card library seed, hashing (spec 05)",
  "sideEffects": false,
  "exports": {
    ".": {
      "bantoozi-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@bantoozi/shared": "workspace:*"
  },
  "devDependencies": {}
}
