<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
<channel>
<title>Media Examples</title>
<link>https://media.example.com/</link>
<description>Image selection order.</description>
<item>
<title>Enclosure image wins</title>
<link>https://media.example.com/1</link>
<enclosure url="https://media.example.com/img/1-enclosure.jpg" type="image/jpeg" length="1000"/>
<media:content url="https://media.example.com/img/1-media.jpg" medium="image"/>
<media:thumbnail url="https://media.example.com/img/1-thumb.jpg"/>
<description>&lt;img src="https://media.example.com/img/1-inline.jpg"&gt; One.</description>
</item>
<item>
<title>Audio enclosure is skipped, media:content image is used</title>
<link>https://media.example.com/2</link>
<enclosure url="https://media.example.com/audio/2.mp3" type="audio/mpeg" length="1000"/>
<media:content url="https://media.example.com/video/2.mp4" medium="video" type="video/mp4"/>
<media:content url="https://media.example.com/img/2-media.png" type="image/png"/>
<description>Two.</description>
</item>
<item>
<title>Video with a nested thumbnail</title>
<link>https://media.example.com/3</link>
<media:content url="https://media.example.com/video/3.mp4" medium="video">
  <media:thumbnail url="https://media.example.com/img/3-thumb.jpg" width="320" height="180"/>
</media:content>
<description>Three.</description>
</item>
<item>
<title>media:group without medium, image by extension</title>
<link>https://media.example.com/4</link>
<media:group>
  <media:content url="https://media.example.com/img/4-large.webp?w=1200" width="1200"/>
  <media:thumbnail url="https://media.example.com/img/4-small.webp"/>
</media:group>
<description>Four.</description>
</item>
<item>
<title>First inline image after a tracking pixel</title>
<link>https://media.example.com/5</link>
<content:encoded><![CDATA[<p><img src="https://pixel.example/t.gif" width="1" height="1"><img src="data:image/png;base64,iVBORw0KGgo=" alt=""><img src="https://pixel.example/hidden.gif" style="display:none"><img src="/img/5-inline.jpg" alt="Five"> Five.</p>]]></content:encoded>
</item>
<item>
<title>Relative media:thumbnail</title>
<link>https://media.example.com/6</link>
<media:thumbnail url="/img/6-thumb.jpg"/>
<description>Six.</description>
</item>
</channel>
</rss>
