exports[`feed fixtures (spec 03 §12, §13) > rss2.xml parses to the expected result 1`] = `
{
  "feed": {
    "description": "Notes on distributed systems, databases & the web.",
    "iconUrl": "https://blog.example.com/assets/logo-144.png",
    "langHint": "en",
    "language": "en-US",
    "siteUrl": "https://blog.example.com/",
    "syUpdateFrequency": 2,
    "syUpdatePeriod": "hourly",
    "title": "Example Engineering Blog",
    "ttlMinutes": 60,
  },
  "itemErrorCount": 0,
  "itemErrors": [],
  "items": [
    {
      "author": "Jana Nováková",
      "categories": [
        "Databases",
        "PostgreSQL",
        "News & Opinion",
      ],
      "contentHash": "73a69438ef9bbed313f8edc9e41dd35934c0570c46880239b673135a424a2e09",
      "excerpt": "For three years our workers pulled jobs from a separate message broker. Keeping it consistent with the database cost us more than it saved. The outbox pattern Every state change and its follow-up work are written in one transaction. Read the locking documentation for the details. Jobs flow from the outbox to the workers. SELECT * FROM outbox ORDER BY id FOR UPDATE SKIP LOCKED LIMIT 10; The post Why we moved our job queue into PostgreSQL appeared first on Example Engineering Blog.",
      "excerptHtml": "<p>For three years our workers pulled jobs from a separate message broker. Keeping it consistent with the database cost us more than it saved.</p>
<h2>The outbox pattern</h2>
<p>Every state change and its follow-up work are written in <strong>one transaction</strong>. Read the <a href="https://www.postgresql.org/docs/current/sql-select.html#SQL-FOR-UPDATE-SHARE" rel="noopener noreferrer nofollow" target="_blank">locking documentation</a> for the details.</p>
<figure><figcaption>Jobs flow from the outbox to the workers.</figcaption></figure>
<pre><code>SELECT * FROM outbox ORDER BY id FOR UPDATE SKIP LOCKED LIMIT 10;</code></pre>
<p>The post <a href="https://blog.example.com/2026/09/postgres-job-queue/" rel="noopener noreferrer nofollow" target="_blank">Why we moved our job queue into PostgreSQL</a> appeared first on <a href="https://blog.example.com/" rel="noopener noreferrer nofollow" target="_blank">Example Engineering Blog</a>.</p>",
      "feedBodyHtml": "<p>For three years our workers pulled jobs from a separate message broker. Keeping it consistent with the database cost us more than it saved.</p>
<h2>The outbox pattern</h2>
<p>Every state change and its follow-up work are written in <strong>one transaction</strong>. Read the <a href="https://www.postgresql.org/docs/current/sql-select.html#SQL-FOR-UPDATE-SHARE" rel="noopener noreferrer nofollow" target="_blank">locking documentation</a> for the details.</p>
<figure><figcaption>Jobs flow from the outbox to the workers.</figcaption></figure>
<pre><code>SELECT * FROM outbox ORDER BY id FOR UPDATE SKIP LOCKED LIMIT 10;</code></pre>
<p>The post <a href="https://blog.example.com/2026/09/postgres-job-queue/" rel="noopener noreferrer nofollow" target="_blank">Why we moved our job queue into PostgreSQL</a> appeared first on <a href="https://blog.example.com/" rel="noopener noreferrer nofollow" target="_blank">Example Engineering Blog</a>.</p>",
      "feedBodyImageCount": 1,
      "feedBodyText": "For three years our workers pulled jobs from a separate message broker. Keeping it consistent with the database cost us more than it saved.

The outbox pattern

Every state change and its follow-up work are written in one transaction. Read the locking documentation for the details.

Jobs flow from the outbox to the workers.

SELECT * FROM outbox ORDER BY id FOR UPDATE SKIP LOCKED LIMIT 10;

The post Why we moved our job queue into PostgreSQL appeared first on Example Engineering Blog.",
      "feedBodyTruncated": false,
      "guid": "https://blog.example.com/?p=4812",
      "imageUrl": "https://blog.example.com/wp-content/uploads/2026/09/queue-diagram.png",
      "link": "https://blog.example.com/2026/09/postgres-job-queue/?utm_source=rss&utm_medium=rss",
      "publishedAt": 2026-09-25T14:05:00.000Z,
      "sourceIndex": 0,
      "title": "Why we moved our job queue into PostgreSQL",
      "titleNorm": "why we moved our job queue into postgresql",
      "videoEvidence": false,
    },
    {
      "author": "releases@example.com (Release Team)",
      "categories": [
        "release",
      ],
      "contentHash": "847a977299075d84654342769d8c92c37c2d0bf293acbc2d0d94e22aeb9764da",
      "excerpt": "Version 4.2 is out. Search is up to 3× faster & index builds use half the memory.",
      "excerptHtml": "Version 4.2 is out. Search is up to 3× faster &amp; index builds use half the memory.",
      "feedBodyHtml": "Version 4.2 is out. Search is up to 3× faster &amp; index builds use half the memory.",
