exports[`feed fixtures (spec 03 §12, §13) > full-content-images.xml parses to the expected result 1`] = `
{
  "feed": {
    "description": "News from the Riverside allotment association.",
    "iconUrl": null,
    "langHint": "en",
    "language": "en-GB",
    "siteUrl": "https://garden.example.org/",
    "syUpdateFrequency": null,
    "syUpdatePeriod": null,
    "title": "Riverside Allotments",
    "ttlMinutes": null,
  },
  "itemErrorCount": 0,
  "itemErrors": [],
  "items": [
    {
      "author": "Hana Kovač",
      "categories": [
        "Association news",
      ],
      "contentHash": "2c8fb5fcb5a949084c2b2b4a866129f1d98f4897e325e5c59632875208f9660b",
      "excerpt": "The allotment association opened its new seed library on Saturday, two years after members first proposed swapping the seeds they save each autumn. More than 140 varieties are on the shelves. Members can borrow up to five packets a season and are asked to return seed from the healthiest plants of each variety. Volunteers sorted the donations over the summer. The library is in the shed next to plot 17 and opens on Saturday mornings until the end of October. The post The seed library is open appeared first on Riverside Allotments.",
      "excerptHtml": "<p>The allotment association opened its new seed library on Saturday, two years after members first proposed swapping the seeds they save each autumn.</p>
<figure><figcaption>More than 140 varieties are on the shelves.</figcaption></figure>
<p>Members can borrow up to five packets a season and are asked to return seed from the healthiest plants of each variety.</p>
<figure><figcaption>Volunteers sorted the donations over the summer.</figcaption></figure>
<p>The library is in the shed next to plot 17 and opens on Saturday mornings until the end of October.</p>
<p>The post <a href="https://garden.example.org/2026/09/seed-library-opens/" rel="noopener noreferrer nofollow" target="_blank">The seed library is open</a> appeared first on <a href="https://garden.example.org/" rel="noopener noreferrer nofollow" target="_blank">Riverside Allotments</a>.</p>",
      "feedBodyHtml": "<p>The allotment association opened its new seed library on Saturday, two years after members first proposed swapping the seeds they save each autumn.</p>
<figure><figcaption>More than 140 varieties are on the shelves.</figcaption></figure>
<p>Members can borrow up to five packets a season and are asked to return seed from the healthiest plants of each variety.</p>
<figure><figcaption>Volunteers sorted the donations over the summer.</figcaption></figure>
<p>The library is in the shed next to plot 17 and opens on Saturday mornings until the end of October.</p>
<p>The post <a href="https://garden.example.org/2026/09/seed-library-opens/" rel="noopener noreferrer nofollow" target="_blank">The seed library is open</a> appeared first on <a href="https://garden.example.org/" rel="noopener noreferrer nofollow" target="_blank">Riverside Allotments</a>.</p>",
      "feedBodyImageCount": 3,
      "feedBodyText": "The allotment association opened its new seed library on Saturday, two years after members first proposed swapping the seeds they save each autumn.

More than 140 varieties are on the shelves.

Members can borrow up to five packets a season and are asked to return seed from the healthiest plants of each variety.

Volunteers sorted the donations over the summer.

The library is in the shed next to plot 17 and opens on Saturday mornings until the end of October.

