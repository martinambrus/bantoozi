{
  "name": "@bantoozi/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Config, settings registry, DTOs, jobs, ports, errors, ids, clock, mailer, text utils",
  "sideEffects": false,
  "exports": {
    ".": {
      "bantoozi-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "bantoozi-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/credential-crypto": {
      "bantoozi-source": "./src/server/credential-crypto.ts",
      "types": "./dist/server/credential-crypto.d.ts",
      "default": "./dist/server/credential-crypto.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "franc-all": "7.2.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
