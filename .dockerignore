# Build context of infra/docker/Dockerfile (the repository root). Keep secrets, VCS data, installed
# dependencies and build output out of the context: the image build installs and builds from scratch.
.git
.github
.claude
.vscode
.idea
**/node_modules
**/dist
**/coverage
**/.turbo
**/.vitest
**/*.tsbuildinfo
**/*.log
.env
.env.*
!.env.example
infra/env
docs
apps/web/dev-dist
apps/web/test-results
apps/web/playwright-report
apps/eval/reports
packages/testing/fixtures
